default: &default
  adapter: mysql2
  encoding: utf8
  pool: 5
  timeout: 5000
  username: <%= ENV.fetch('DATABASE_USERNAME', 'root') %>
  password: <%= ENV['DATABASE_PASSWORD'] %>
  # 'localhost' routes to a socket connection for standard local devs.
  # CI and Docker will override this via ENV to force TCP.
  host: <%= ENV.fetch('DATABASE_HOST', ENV.fetch('TEST_DATABASE_HOST', 'localhost')) %>
  variables:
    sql_mode: TRADITIONAL

development:
  <<: *default
  # Defaults to standard naming for local devs. 
  database: <%= ENV.fetch('DATABASE_NAME', 'cwf_development') %>

test:
  <<: *default
  # Checks CI's specific name first, then generic ENV, then defaults to standard standard local naming.
  database: <%= ENV.fetch('FULFILLMENT_DATABASE_NAME', ENV.fetch('TEST_DATABASE_NAME', 'cwf_test')) %>