development:
  username: root
  adapter: mysql2
  encoding: utf8
  database: cwf_development
  pool: 5
  timeout: 5000
  variables:
    sql_mode: TRADITIONAL

# configured for travis-ci
# test: &test
#  adapter: mysql2
#  encoding: utf8
#  database: cwf_test
#  username: travis
#  pool: 5
#  timeout: 5000
#  variables:
#    sql_mode: TRADITIONAL

# configured for github actions ci
test:
  adapter: mysql2
  encoding: utf8
  database: <%= ENV.fetch('FULFILLMENT_DATABASE_NAME', 'cwf_test') %>
  username: <%= ENV.fetch('DATABASE_USERNAME', 'root') %>
  password: <%= ENV['DATABASE_PASSWORD'] %>
  host: <%= ENV['DATABASE_HOST'] || '127.0.0.1' %>
  pool: 5
  timeout: 5000
  variables:
    sql_mode: TRADITIONAL

# Docker Config

default: &default
  adapter: mysql2
  encoding: utf8
  pool: 5
  timeout: 5000
  username: <%= ENV['DATABASE_USERNAME'] %>
  password: <%= ENV['DATABASE_PASSWORD'] %>
  variables:
    sql_mode: TRADITIONAL

development:
  <<: *default
  host: <%= ENV['DATABASE_HOST'] %>
  database: cwf-docker_development

test:
  <<: *default
  host: <%= ENV['TEST_DATABASE_HOST'] %>
  database: cwf-docker_test