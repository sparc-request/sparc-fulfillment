- show_my_entries = current_identity.clinical_provider?
- show_team_approval = current_identity.time_tracking_manager?
- active_tab = show_my_entries ? 'my_entries' : 'team'

%main.w-100#timeTrackingDashboard
  - if show_my_entries && show_team_approval
    %ul.nav.nav-tabs.mb-3#timeTrackingTabs{ role: 'tablist' }
      %li.nav-item
        %a.nav-link#myTimeEntriesTabLink{ class: active_tab == 'my_entries' ? 'active font-weight-bold' : '', data: { toggle: 'tab' }, href: '#myTimeEntriesPane', role: 'tab' }
          My Time Entries
      %li.nav-item
        %a.nav-link#teamApprovalTabLink{ class: active_tab == 'team' ? 'active font-weight-bold' : '', data: { toggle: 'tab' }, href: '#teamApprovalPane', role: 'tab' }
          Team Approval

  .tab-content
    - if show_my_entries
      .tab-pane.fade#myTimeEntriesPane{ class: active_tab == 'my_entries' ? 'show active' : '', role: 'tabpanel' }
        = render 'my_time_entries'

    - if show_team_approval
      .tab-pane.fade#teamApprovalPane{ class: active_tab == 'team' ? 'show active' : '', role: 'tabpanel' }
        = render 'team_approval'

