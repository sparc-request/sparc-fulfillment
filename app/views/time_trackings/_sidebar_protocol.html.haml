- protocol = item.protocol
- srid = protocol.srid.delete(' ')
- pi = protocol.pi ? ", #{protocol.pi.full_name}" : ""
- tooltip = "#{srid} (#{protocol.short_title}#{pi})"
- title = item.working_title.presence || protocol.short_title
- label = "#{srid} (#{title.truncate(25)}#{pi})"
- star_icon = item.favorite ? 'fas' : 'far'

.tree-header.p-0.d-flex.align-items-center.justify-content-between{ id: "#{tab_prefix}-sidebar-protocol-#{protocol.id}" }
  %button.btn.btn-link.text-left.text-truncate.font-weight-bold.text-primary.p-1.flex-grow-1{ type: "button", class: (is_open ? '' : 'collapsed'), data: { toggle: "collapse", target: "##{tab_prefix}-collapse-protocol-#{protocol.id}" }, aria: { expanded: is_open.to_s, controls: "#{tab_prefix}-collapse-protocol-#{protocol.id}" }, title: tooltip }
    = icon('fas', 'caret-down', class: 'mr-1')
    = icon('fas', 'folder', class: 'mr-1 text-secondary')
    = label
  = link_to icon('fas', 'edit'), edit_protocol_title_time_trackings_path(protocol_id: protocol.id), remote: true, class: 'btn btn-sm btn-link text-muted p-1 mr-1', title: 'Edit working title'
  = link_to icon(star_icon, 'star'), toggle_favorite_protocol_time_trackings_path(protocol_id: protocol.id), method: :put, remote: true, class: 'btn btn-sm btn-link text-warning p-1 mr-1', title: "Toggle Favorite"
  = link_to icon('fas', 'trash'), remove_protocol_time_trackings_path(protocol_id: protocol.id), method: :delete, remote: true, data: { confirm_swal: 'true', text: 'Are you sure you want to remove this protocol from your sidebar?' }, class: 'btn btn-sm btn-link text-danger p-1', title: 'Remove protocol'


