.modal-dialog{ role: "document" }
  .modal-content
    = form_tag time_tracking_path(time_tracking), method: :put, remote: true, id: 'timeTrackingForm' do
      .modal-header
        %h5.modal-title.text-dark Edit Time Entry
        %button.close{ type: "button", data: { dismiss: "modal" }, aria: { label: "Close" } }
          %span{ aria: { hidden: "true" } } &times;
      .modal-body
        .row.mb-3
          .col-12
            %strong.text-dark= time_tracking.protocol&.srid
            %span.text-muted >
            %strong.text-dark= time_tracking.line_item&.service&.name
            - if time_tracking.component_name.present?
              %span.text-muted >
              %strong.text-dark= time_tracking.component_name

        .form-group.row
          %label.col-sm-3.col-form-label Fulfillment Date *
          .col-sm-7
            .input-group.datetimepicker.date{ id: 'timeTrackingDatePicker', data: { target_input: 'nearest' } }
              = text_field_tag 'time_tracking[date]', time_tracking.date&.strftime('%m/%d/%Y'), class: 'form-control datetimepicker-input', readonly: true, data: { target: '#timeTrackingDatePicker', toggle: 'datetimepicker' }
              .input-group-append{ data: { toggle: 'datetimepicker', target: '#timeTrackingDatePicker' } }
                .input-group-text
                  %span.far.fa-calendar

        .form-group.row
          %label.col-sm-3.col-form-label Start Time *
          .col-sm-7
            = time_field_tag 'time_tracking[started_at]', time_tracking.started_at&.strftime('%H:%M'), class: 'form-control', required: true, id: 'timeTrackingStartTime'

        .form-group.row
          %label.col-sm-3.col-form-label End Time *
          .col-sm-7
            = time_field_tag 'time_tracking[ended_at]', time_tracking.ended_at&.strftime('%H:%M'), class: 'form-control', required: true, id: 'timeTrackingEndTime'

        .form-group.row
          %label.col-sm-3.col-form-label Qty
          .col-sm-7
            = number_field_tag 'time_tracking[quantity]', number_with_precision(time_tracking.quantity, precision: 2), class: 'form-control', step: '0.01', readonly: true, id: 'timeTrackingQty'

        .form-group.row
          %label.col-sm-3.col-form-label Performed By *
          .col-sm-7
            = text_field_tag 'performed_by', time_tracking.identity&.full_name, class: 'form-control', readonly: true

        - if time_tracking.line_item&.service&.components.present?
          .form-group.row
            %label.col-sm-3.col-form-label Fulfillment Component
            .col-sm-7
              = select_tag 'time_tracking[component_name]', options_for_select(time_tracking.line_item.service.components_list, time_tracking.component_name), include_blank: 'Please Select', class: 'form-control selectpicker', data: { width: '100%' }

        .form-group.row
          %label.col-sm-3.col-form-label Notes
          .col-sm-7
            = text_area_tag 'time_tracking[notes]', time_tracking.notes, class: 'form-control', rows: 3

      .modal-footer
        %button.btn.btn-secondary{ type: "button", data: { dismiss: "modal" } } Close
        = submit_tag "Save", class: "btn btn-primary"


